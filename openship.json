{
  "$schema": "https://openship.io/openship.schema.json",
  "framework": "docker-compose",
  "services": [
    {
      "name": "postgres",
      "image": "postgres:15-alpine",
      "env": {
        "POSTGRES_USER": "user",
        "POSTGRES_PASSWORD": "password",
        "POSTGRES_DB": "codeatlas"
      },
      "ports": ["5432:5432"],
      "volumes": ["postgres_data:/var/lib/postgresql/data"],
      "healthcheck": {
        "test": ["CMD-SHELL", "pg_isready -U user -d codeatlas"],
        "interval": "10s",
        "timeout": "5s",
        "retries": 5
      }
    },
    {
      "name": "neo4j",
      "image": "neo4j:5",
      "env": {
        "NEO4J_AUTH": "neo4j/password"
      },
      "ports": ["7474:7474", "7687:7687"],
      "volumes": ["neo4j_data:/data"],
      "healthcheck": {
        "test": ["CMD-SHELL", "wget --no-verbose --tries=1 --spider localhost:7474 || exit 1"],
        "interval": "10s",
        "timeout": "5s",
        "retries": 5
      }
    },
    {
      "name": "backend",
      "build": "./backend",
      "dockerfile": "Dockerfile",
      "env": {
        "DATABASE_URL": "postgresql://user:password@postgres:5432/codeatlas",
        "NEO4J_URI": "bolt://neo4j:7687",
        "NEO4J_USER": "neo4j",
        "NEO4J_PASSWORD": "password"
      },
      "ports": ["8000:8000"],
      "dependsOn": ["postgres", "neo4j"]
    },
    {
      "name": "frontend",
      "build": "./frontend",
      "dockerfile": "Dockerfile",
      "env": {
        "NEXT_PUBLIC_API_URL": "http://localhost:8000"
      },
      "ports": ["3000:3000"],
      "dependsOn": ["backend"]
    }
  ]
}
